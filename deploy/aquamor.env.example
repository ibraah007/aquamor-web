# Copy this file to /etc/aquamor/aquamor.env and set the real values.
#   sudo install -d -m 750 /etc/aquamor
#   sudo install -m 600 deploy/aquamor.env.example /etc/aquamor/aquamor.env
#   sudoedit /etc/aquamor/aquamor.env

# Loopback only. Caddy on the same machine proxies public traffic to it.
ADDR=127.0.0.1:8080

DB_PATH=/var/lib/aquamor/aquamor.db
WEB_DIR=/opt/aquamor/web

# Generate a long random value, for example:
#   openssl rand -hex 32
# Never commit the real token. Without it the orders endpoint returns 503.
ADMIN_TOKEN=replace-with-a-long-random-token

# Online payments use Flutterwave hosted checkout. Leave all three values empty
# to hide the Pay online button and keep WhatsApp-only ordering. Get the keys
# from the Flutterwave dashboard (Settings > API keys) and set the same secret
# hash under Settings > Webhooks.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
# Public HTTPS address of the site, used for the payment return page.
PUBLIC_BASE_URL=https://aquamor.co.ke
