# Replace aquamor.co.ke with the chosen domain, then reload Caddy.
# Caddy obtains and renews the TLS certificate automatically.
#
# The Go server listens on loopback only (ADDR=127.0.0.1:8080), so it is not
# reachable from the internet except through this proxy.

aquamor.co.ke {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

# Keep one canonical hostname. If the client prefers www, swap these two blocks.
www.aquamor.co.ke {
	redir https://aquamor.co.ke{uri} permanent
}
